<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark, edge-to-edge base. Compose draws the real UI; this just sets the
         window background so there is no white flash before Compose paints. -->
    <style name="Theme.SAGIP" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
