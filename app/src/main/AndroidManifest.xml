<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      SAGIP is offline-by-design. We intentionally do NOT request the INTERNET
      permission. The app cannot phone home even if it wanted to — the core
      "when the internet dies, your AI doesn't" guarantee, enforced by the
      manifest. ponytail: this is the cheapest, strongest proof of offline.

      READ_CONTACTS is only used so onboarding can let the user PICK their
      emergency contact's number from the device — purely local, no network.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Coarse/fine location: ONLY for the one-tap "use my location" in onboarding
         to fill barangay/city via on-device reverse geocoding. No network, no tracking. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Microphone: for voice input via on-device SpeechRecognizer. Offline-capable. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Needed on Android 11+ so SpeechRecognizer can find the on-device recognizer. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="SAGIP"
        android:supportsRtl="true"
        android:theme="@style/Theme.SAGIP">
        <uses-native-library android:name="libvndksupport.so" android:required="false"/>
        <uses-native-library android:name="libOpenCL.so" android:required="false"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAGIP">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
